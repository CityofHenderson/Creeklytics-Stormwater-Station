#include <Adafruit_SleepyDog.h>
#include <MKRNB.h>
/* 
  Sketch generated by the Arduino IoT Cloud Thing "Untitled 4"
  https://create.arduino.cc/cloud/things/d3d2a453-47d4-48c9-ab71-69a811b431ae 

  Arduino IoT Cloud Variables description

  The following variables are automatically generated and updated when changes are made to the Thing

  float densityCloud;
  float depthCloud;
  float mA;
  float offsetCloud;
  int averagingInterval;

  Variables which are marked as READ/WRITE in the Cloud Thing will also have functions
  which are called when their values are changed from the Dashboard.
  These functions are generated with the Thing and added at the end of this sketch.
*/
#include "thingProperties.h"

// Initialize Narrowband for cellular
NB nbAccess;

//constant and variables for Sensor Math
#define ANALOG_PIN A2
#define RANGE 5000                 // Depth measuring range 5000 mm (for water)
#define VREF 3300                  // ADC's reference voltage on your Arduino, typical value: 5000 mV
#define CURRENT_INIT 4.00          // Current @ 0mm (uint: mA)
float DENSITY_CUSTOM = 1;          // Pure water density normalized to 1
#define DENSITY_WATER 1            // Pure water density normalized to 1
#define DENSITY_GASOLINE 0.74      // Gasoline density
int PRINT_INTERVAL = 60000;      // Sensor Delay (in milliseconds = 60 seconds)
int16_t sensorVoltage;
float sensorCurrent, depth;        // unit: mA
unsigned long timepoint_measure;
float offset = 0;

//Array Variables
#define NUM_READINGS 10              // Number of readings
float depthReadings[NUM_READINGS-1]; // Array to store readings
float totalDepth = 0.0;              // Sum of the readings
int readingCount = 0;                // Counter for the number of readings
float averageDepth;

void setup() {
  Serial.begin(9600);              // Initialize serial and wait for port to open:
  delay(1500);                     // This delay gives the chance to wait for a Serial Monitor without blocking if none is found
  pinMode(ANALOG_PIN, INPUT);
  timepoint_measure = 0;
  initProperties();                // Defined in thingProperties.h
  pinMode(LED_BUILTIN, OUTPUT);
  bool connected = false;          // Near Band connection state (will change once connection is established)
  analogReadResolution(12);

  // Enable the watchdog timer with an 8-second timeout
  int timeoutMS = Watchdog.enable(8000); // Timeout in milliseconds
  Serial.println("Watchdog timer enabled for " + String(timeoutMS) + " milliseconds");
  
  // Start NB connection
  while (!connected) {
    if (nbAccess.begin(PINNUMBER) == NB_READY) {
      connected = true;
    } else {
      //Serial.println("Not connected");
      delay(1000);
    }
  }

  // Connect to Arduino IoT Cloud
  ArduinoCloud.begin(ArduinoIoTPreferredConnection);

  densityCloud = DENSITY_CUSTOM;   //get Density from Cloud
  //averagingInterval = PRINT_INTERVAL;  //get Sensor Delay Interval from 
  
  /*
     The following function allows you to obtain more information
     related to the state of network and IoT Cloud connection and errors
     the higher number the more granular information you’ll get.
     The default is 0 (only errors).
     Maximum is 4
 */
  setDebugMessageLevel(2);
  ArduinoCloud.printDebugInfo();
}

void getDepth() {
      sensorVoltage = analogRead(ANALOG_PIN) / 4095.0 * VREF;
      sensorCurrent = sensorVoltage / 120.0;                                    // Sense Resistor: 120 ohm
      depth = (sensorCurrent - CURRENT_INIT) * (RANGE / DENSITY_CUSTOM / 16.0); // Calculate depth from current readings
      if (depth < 0) {
        depth = 0.0;
      }
	  Serial.println("Current Depth: " + String(depth) + " mm");
}
void sendDataToCloud(){
	depthCloud = averageDepth;
	mA = sensorCurrent;

	//Serial print results
	Serial.println("Average Depth: " + String(averageDepth) + " mm");
	Serial.println("Current: " + String(sensorCurrent) + " mA");
	Serial.println("Voltage: " + String(ANALOG_PIN) + " V");

	//Toggle LED for 1 second
	digitalWrite(LED_BUILTIN, HIGH);
	delay(1000);
	digitalWrite(LED_BUILTIN, LOW);
}

void loop() {
// Refresh the watchdog timer to prevent a reset
  Watchdog.reset();

  // Check if the NB-IoT connection is lost
  if (nbAccess.status() != NB_READY) {
    Serial.println("Connection lost, attempting to reconnect...");
    bool reconnected = false;
    while (!reconnected) {
      if (nbAccess.begin(PINNUMBER) == NB_READY) {
        Serial.println("Reconnected to NB-IoT network.");
        reconnected = true;
        // Reinitialize the IoT Cloud connection
        ArduinoCloud.begin(ArduinoIoTPreferredConnection);
      } else {
        Serial.println("Reconnection failed, retrying...");
        delay(1000); // Wait 1 second before retrying
      }
    }
  }

  // Check if connected to Arduino IoT Cloud
  //if (!ArduinoCloud.connected()) {
    //Serial.println("Disconnected from Arduino IoT Cloud, reconnecting...");
   // ArduinoCloud.begin(ArduinoIoTPreferredConnection);
  //}
  
  ArduinoCloud.update();

  {
    if ((millis() - timepoint_measure) > (unsigned long)PRINT_INTERVAL) {
      timepoint_measure = millis();         // Set timepoint_measure to current time to compare to next time the loop runs
      Serial.println("Run Time: " + String(timepoint_measure));
      Serial.println("Print Interval: " + String(PRINT_INTERVAL));

      for (int i = 1; i <= NUM_READINGS; i++) {
		Serial.println("Depth Reading: " + String(i) + " of " + NUM_READINGS);
		getDepth();
        depthReadings[readingCount] = depth;
		totalDepth += depth; // Add to total for averaging
		readingCount++; // Increment reading counter
        delay(1000);
		
      }
	  if (NUM_READINGS >= 1) {
		averageDepth = totalDepth / NUM_READINGS;
        //averageDepth = round(averageDepth * 10) / 10; // rounds to the closest .1mm
        averageDepth = round(averageDepth / 5) * 5; // to round to the closest 5mm
        averageDepth = averageDepth - 70 + offset; // calibration of -70mm from reading then add height offset
		sendDataToCloud();
	  }

	  readingCount = 0;
      totalDepth = 0.0;
    }

  }
}

/*
  READ_WRITE cloud variables executed every time a new value is received from IoT Cloud.
  
  depthCloud is READ_WRITE
  onDepthCloudChange()
  
  densityCloud is READ_WRITE
  onDensityCloudChange()
  
  intervalCloud is READ_WRITE
  onIntervalCloudChange()

*/
void onDepthCloudChange() {
  return;
}

void onDensityCloudChange() {
  DENSITY_CUSTOM = densityCloud; // Make Interval match cloud variable
}


/*
  Since AveragingInterval is READ_WRITE variable, onAveragingIntervalChange() is
  executed every time a new value is received from IoT Cloud.
*/
void onAveragingIntervalChange()  {
  // Add your code here to act upon AveragingInterval change
  PRINT_INTERVAL = averagingInterval;
}

/*
  Since OffsetCloud is READ_WRITE variable, onOffsetCloudChange() is
  executed every time a new value is received from IoT Cloud.
*/
void onOffsetCloudChange()  {
  // Add your code here to act upon OffsetCloud change
  offset = offsetCloud;
}